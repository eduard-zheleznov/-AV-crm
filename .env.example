# Copy this file to .env. Never commit real credentials.
LPTRACKER_LOGIN=operator@example.com
LPTRACKER_PASSWORD=replace-me
LPTRACKER_PROJECT_ID=
LPTRACKER_PROJECT_NAME=
LPTRACKER_FIELD_NAME=Тег+ для новых с Ав и Ян
LPTRACKER_FIELD_VALUE=Сбор № лпр (Ав, ремонт кв. под ключ)

# Google Sheets service-account JSON must stay outside Git.
GOOGLE_CREDENTIALS_FILE=C:\\secure\\google-service-account.json
GOOGLE_SPREADSHEET_ID=
GOOGLE_WORKSHEET=Лист1

