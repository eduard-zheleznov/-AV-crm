# Copy this file to .env. Never commit real credentials.
LPTRACKER_LOGIN=operator@example.com
LPTRACKER_PASSWORD=replace-me
LPTRACKER_BASE_URL=https://direct.lptracker.ru
LPTRACKER_SERVICE_NAME=Avito CRM Pipeline
LPTRACKER_PROJECT_ID=
LPTRACKER_PROJECT_NAME=
LPTRACKER_FIELD_NAME=Тег+ для новых с Ав и Ян
LPTRACKER_FIELD_VALUE=Сбор № лпр (Ав, ремонт кв. под ключ)
LPTRACKER_AUTORESPONDER_FUNNEL_NAME=Автоответчики
LPTRACKER_NO_ANSWER_FUNNEL_NAME=Недозвон
LPTRACKER_NEW_LEAD_FUNNEL_NAME=Новый Лид
LPTRACKER_REPEAT_FUNNEL_NAME=Повторный лид
LPTRACKER_PENDING_FUNNEL_NAMES=Новый лид,⚙️ Лид с робота
CRM_MONITOR_MAX_HOURS=24
CRM_MONITOR_BATCH_SIZE=20
# Time zone used for LPTracker date strings that do not contain an offset.
LPTRACKER_TIMEZONE=Europe/Moscow
CRM_DUPLICATE_POLICY=skip

# Google Sheets service-account JSON must stay outside Git.
GOOGLE_CREDENTIALS_FILE=C:\\secure\\google-service-account.json
GOOGLE_SPREADSHEET_ID=
GOOGLE_WORKSHEET=Лист1
# Remote control and audit tabs are created automatically by the setup command.
GOOGLE_CONTROL_WORKSHEET=Управление
GOOGLE_HISTORY_WORKSHEET=История запусков
GOOGLE_PLAN_WORKSHEET=План загрузки
REMOTE_CONTROL_POLL_SECONDS=20
# 0 means: process every actionable row; positive values remain an optional per-run goal.
GUI_DEFAULT_LIMIT=0
GUI_RETRY_MANUAL=false

# Telegram Bot API. The token and Chat IDs stay only in the local ignored .env.
# Every recipient must first open the bot and send /start.
TELEGRAM_BOT_TOKEN=
TELEGRAM_PRIMARY_CHAT_IDS=
TELEGRAM_BACKUP_CHAT_IDS=
TELEGRAM_CAPTCHA_REMINDER_MINUTES=30,60
TELEGRAM_REQUEST_TIMEOUT_SECONDS=15
TELEGRAM_SEND_ATTEMPTS=3
# Completion statistics can be selected independently from CAPTCHA escalation.
TELEGRAM_COMPLETION_PRIMARY=true
TELEGRAM_COMPLETION_BACKUP=true

# MAX Bot API. Recipient format: user:123 for a person, chat:456 for a group.
# The token and recipient IDs stay only in the local ignored .env.
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_BOT_TOKEN=
MAX_PRIMARY_RECIPIENTS=
MAX_BACKUP_RECIPIENTS=
MAX_REQUEST_TIMEOUT_SECONDS=15
MAX_SEND_ATTEMPTS=3
MAX_COMPLETION_PRIMARY=true
MAX_COMPLETION_BACKUP=true

# SMTP fallback. For Yandex use a Mail app password, never the account password.
# Delivery order: MAX, Email, Telegram. A failed channel is disabled for the current run.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
EMAIL_PRIMARY_RECIPIENTS=
EMAIL_BACKUP_RECIPIENTS=
EMAIL_REQUEST_TIMEOUT_SECONDS=20
EMAIL_SEND_ATTEMPTS=2
EMAIL_COMPLETION_PRIMARY=true
EMAIL_COMPLETION_BACKUP=true
# Optional friendly label included in alerts; Windows computer name is used by default.
NOTIFICATION_COMPUTER_NAME=

# Queue columns. Existing columns are preserved; service columns are added.
QUEUE_URL_COLUMN=Ссылка
QUEUE_STATUS_COLUMN=Статус
QUEUE_PHONE_COLUMN=Телефон
QUEUE_CRM_LEAD_COLUMN=CRM lead ID
QUEUE_FUNNEL_STAGE_COLUMN=Шаг воронки
QUEUE_CRM_CREATE_COUNT_COLUMN=Попытка завода в CRM
QUEUE_REPEAT_CRM_LEAD_COLUMN=Повторный CRM ID
QUEUE_REPEAT_PHONE_ATTEMPTS_COLUMN=Попытки повторного открытия
QUEUE_ERROR_COLUMN=Ошибка
QUEUE_ATTEMPTS_COLUMN=Попытки
QUEUE_PROCESSED_AT_COLUMN=Обработано
QUEUE_RUN_ID_COLUMN=Run ID
QUEUE_NEXT_RETRY_AT_COLUMN=Следующая попытка

# A lead is created only while the advertiser's local time is inside this window.
# Moscow offset and queue priority are read from GOOGLE_PLAN_WORKSHEET by URL.
LOCAL_TIME_GUARD_ENABLED=true
LOCAL_CALL_START=10:00
LOCAL_LEAD_CUTOFF=19:45
PHONE_RETRY_DELAY_MINUTES=30

# Visible persistent Chromium session. Avito login is optional; guest state also persists.
# Use the GUI's "Открыть профиль" button to log in, log out or remain signed out.
# Conservative defaults; no stealth bypass.
AVITO_HEADLESS=false
AVITO_PROFILE_DIR=data/browser-profile
AVITO_MIN_DELAY_SECONDS=7
AVITO_MAX_DELAY_SECONDS=15
AVITO_PAGE_TIMEOUT_SECONDS=45
# Keep the browser paused up to 12 hours for unattended CAPTCHA handling.
AVITO_MANUAL_TIMEOUT_SECONDS=43200
AVITO_SCREENSHOT_DIR=output/diagnostics

# One initial click, one click after reload, then one delayed final click.
AVITO_PHONE_FIRST_ROUND_ATTEMPTS=1
AVITO_PHONE_SECOND_ROUND_ATTEMPTS=1
AVITO_PHONE_RETRY_MIN_SECONDS=5
AVITO_PHONE_RETRY_MAX_SECONDS=15
AVITO_TEMP_NUMBER_WAIT_MIN_SECONDS=7
AVITO_TEMP_NUMBER_WAIT_MAX_SECONDS=10
AVITO_AFTER_LABEL_MIN_SECONDS=1.7
AVITO_AFTER_LABEL_MAX_SECONDS=3
AVITO_LONG_BREAK_INTERVAL_MIN_SECONDS=1500
AVITO_LONG_BREAK_INTERVAL_MAX_SECONDS=1800
AVITO_LONG_BREAK_DURATION_MIN_SECONDS=180
AVITO_LONG_BREAK_DURATION_MAX_SECONDS=420

# Windows example: C:\\Program Files\\Tesseract-OCR\\tesseract.exe
TESSERACT_CMD=
OCR_MIN_AGREEMENT=2

PIPELINE_MAX_ATTEMPTS=2
# Hard lifetime cap for unsuccessful repeat phone reveals on an autoresponder row.
CRM_REPEAT_PHONE_MAX_ATTEMPTS=3
PIPELINE_MAX_CONSECUTIVE_FAILURES=5
